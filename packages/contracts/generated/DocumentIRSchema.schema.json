          },
          "tag": {
            "maxLength": 256,
            "type": "string"
          },
          "dep": {
            "maxLength": 32,
            "type": "string"
          },
          "head": {
            "minimum": 0,
            "type": "integer"
          },
          "span": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "type": "integer"
              },
              "end": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "morphology": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 256,
              "type": "string"
            }
          }
        }
      }
    }
  }
}
