    "tokens": {
      "maxItems": 12000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "lemma",
          "reading",
          "pos",
          "tag",
          "dep",
          "head",
          "span",
          "morphology"
