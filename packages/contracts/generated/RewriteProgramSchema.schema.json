{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "seriesId",
    "intensity",
    "edits"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "number"
    },
    "seriesId": {
      "type": "string"
    },
    "intensity": {
      "minimum": 1,
      "maximum": 3,
      "type": "integer"
    },
    "edits": {
      "maxItems": 12000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodeId",
          "sourceSpan",
          "ruleId",
          "from",
          "to",
          "evidenceIds"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "sourceSpan": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "type": "integer"
              },
              "end": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "ruleId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "evidenceIds": {
            "maxItems": 12000,
            "type": "array",
            "items": {
              "maxLength": 12000,
              "type": "string"
            }
          }
        }
      }
    }
  }
}
