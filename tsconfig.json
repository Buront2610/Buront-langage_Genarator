{
  "compilerOptions": {
    "target": "ES2024", "module": "Node16", "moduleResolution": "Node16",
    "esModuleInterop": true, "strict": true, "skipLibCheck": true,
    "rootDir": ".", "outDir": "dist", "resolveJsonModule": true,
    "types": ["node"], "declaration": true
  },
  "include": ["packages/**/*.ts", "apps/server/**/*.ts", "scripts/v1/**/*.ts"],
  "exclude": ["node_modules", "dist", ".venv"]
}
